# Default AI configuration for SiliconFlow.
# Copy this file to .env and fill in your actual API key.

# The API endpoint for the AI service.
AI_API_URL="https://api.siliconflow.cn/v1"

# The API key for the service. Get this from your SiliconFlow account.
AI_API_KEY="your_siliconflow_api_key_here"

# The model to use for the analysis.
# Example SiliconFlow model: Qwen/Qwen2-7B-Instruct
AI_MODEL="Qwen/Qwen2-7B-Instruct"
