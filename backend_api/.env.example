# Example configuration for AI-powered analysis.
# Copy this file to .env and fill in your actual values.

# The full URL to the AI's chat/completions endpoint
# For OpenAI: https://api.openai.com/v1/chat/completions
# For a local Ollama instance: http://localhost:11434/api/chat
AI_API_URL="https://api.openai.com/v1/chat/completions"

# The API key for the service. For OpenAI, this is your secret key.
# For a local Ollama, you can often leave this blank or use a placeholder like "ollama".
AI_API_KEY="your_openai_api_key_here"

# The model to use for the analysis.
# For OpenAI: gpt-4, gpt-3.5-turbo
# For Ollama: llama3, mistral
AI_MODEL="gpt-4"
